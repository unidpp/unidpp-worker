{
  // UniDPP on Cloudflare Workers (REARCH R12)
  "name": "unidpp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "LOG", "class_name": "LogDO" },
      { "name": "TRUST", "class_name": "TrustDO" },
      { "name": "ISSUER", "class_name": "IssuerDO" },
      { "name": "ARCHIVE", "class_name": "ArchiveDO" },
      { "name": "IDENTITY", "class_name": "IdentityDO" },
      { "name": "S13", "class_name": "S13DO" }
    ]
  },
  "r2_buckets": [{ "binding": "ARCHIVE_BUCKET", "bucket_name": "unidpp-archive" }],
  // The tenant dispatch (REARCH R6 on Workers): demo.unidpp.org is
  // the tenant — the same code, an isolated data folder (its own DO
  // namespaces, its own journals, its own identity). app.unidpp.org
  // stays the live estate.
  "vars": {
    "TENANT_HOSTS": "{\"demo.unidpp.org\": \"demo\", \"registry-jp.unidpp.org\": \"jp\"}"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegistryDO", "LogDO", "TrustDO", "IssuerDO", "ArchiveDO", "IdentityDO"] },
    { "tag": "v2", "new_sqlite_classes": ["S13DO"] }
  ],
  "build": {
    "command": "npm run build:wasm"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ]
  // S2+ mounts Durable Object namespaces here (registry, trust, log,
  // issuer, archive, identity, hub, tenants); S7 attaches the seven
  // public hostnames as routes.
}
